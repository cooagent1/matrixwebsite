# Kopieren nach .env.local (lokal) bzw. in Vercel unter Project Settings > Environment Variables eintragen.
# Keine echten Werte in Git.

# Supabase (Anfragen speichern)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Benachrichtigung bei neuer Anfrage)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=Matrix POS <anfragen@example.invalid>
INQUIRY_TO_EMAIL=

# HubSpot Meeting Scheduler (Round Robin)
NEXT_PUBLIC_HUBSPOT_DEMO_URL=
NEXT_PUBLIC_HUBSPOT_CALLBACK_URL=

# Öffentliche URL und Indexierung (erst zum Go-live auf true)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXABLE=false
